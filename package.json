{
  "name": "lingspark-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm --filter @lingspark/rules-builtin build && pnpm --filter @lingspark/core build && pnpm --filter @lingspark/cli build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:converge": "vitest run packages/core/src/e2e",
    "test:scripts": "node packages/desktop/scripts/lib/icon.test.mjs && node packages/desktop/scripts/lib/win-shell.test.mjs",
    "ci": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run test:scripts",
    "build:sea": "pnpm run build && pnpm --filter @lingspark/cli build:sea",
    "build:client": "pnpm run build:sea && pnpm --filter @lingspark/desktop dist",
    "build:client:win": "pnpm run build && pnpm --filter @lingspark/desktop dist:win",
    "build:client:linux": "pnpm run build:sea && pnpm --filter @lingspark/desktop dist:linux"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "esbuild": "0.27.7",
    "eslint": "^9.17.0",
    "globals": "^17.12.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
